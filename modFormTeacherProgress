Attribute VB_Name = "modFormTeacherProgress"
Option Explicit

Private Const FP_NAV_SHEET_NAME As String = "Dashboard"
Private Const FP_NAV_START_CELL As String = "T3"
Private Const FP_NAV_BTN_PREFIX As String = "Nav_FP_"
Private Const SHAPE_ROUNDED_RECTANGLE As Long = 5

'=========================================================
' Module: modFormTeacherProgress
'
' PURPOSE
'   Build form-teacher progress reports comparing two assessments
'   (default WA1 -> WA2) from normalized staging sheets.
'
' OUTPUT
'   1) FT_Progress_<Class>_<From>_<To>
'      One row per student with summary metrics + auto remarks.
'   2) FT_SubjectDelta_<Class>_<From>_<To>
'      One row per Student x Subject delta details.
'
' ASSUMPTIONS
'   - Source sheets have at least:
'       RegNo | Name | Class | Assessment | Year | ...subject columns...
'   - Subject columns may be either:
'       a) score only, OR
'       b) score + immediate grade column named "<Subject> (Grade)"
'   - Grade values may be G3/G2/G1 style and will be normalized into
'     comparable points via GradeToComparablePoint().
'
'=========================================================

Public Sub BuildFormTeacherProgress_WA1_WA2()
    BuildFormTeacherProgress "WA1", "WA2"
End Sub

Public Sub BuildFormTeacherProgress_Prompt()
    Dim fromAssess As String, toAssess As String
    fromAssess = Trim$(InputBox("From assessment (e.g. WA1):", "Form Teacher Progress", "WA1"))
    If fromAssess = "" Then Exit Sub

    toAssess = Trim$(InputBox("To assessment (e.g. WA2):", "Form Teacher Progress", "WA2"))
    If toAssess = "" Then Exit Sub

    BuildFormTeacherProgress fromAssess, toAssess
End Sub

Public Sub BuildFormTeacherProgressAllClasses_Prompt()
    Dim fromAssess As String, toAssess As String
    fromAssess = Trim$(InputBox("From assessment (e.g. WA1):", "Form Teacher Progress - All Classes", "WA1"))
    If fromAssess = "" Then Exit Sub

    toAssess = Trim$(InputBox("To assessment (e.g. WA2):", "Form Teacher Progress - All Classes", "WA2"))
    If toAssess = "" Then Exit Sub

    BuildFormTeacherProgressAllClasses fromAssess, toAssess
End Sub

Public Sub BuildFormTeacherProgress(ByVal fromAssessment As String, ByVal toAssessment As String)
    Dim classCode As String
    classCode = Trim$(InputBox("Class code (e.g. S3A):", "Form Teacher Progress"))
    If classCode = "" Then Exit Sub

    BuildFormTeacherProgressForClass classCode, fromAssessment, toAssessment
End Sub

Public Sub BuildFormTeacherProgressAllClasses(ByVal fromAssessment As String, ByVal toAssessment As String)
    Dim classes As Object
    Dim classCode As Variant
    Dim builtCount As Long
    Dim skippedCount As Long
    Dim wsFrom As Worksheet, wsTo As Worksheet

    Set classes = CollectClassesForAssessment(toAssessment)
    If classes.Count = 0 Then
        MsgBox "No classes found for assessment " & toAssessment & ".", vbExclamation
        Exit Sub
    End If

    builtCount = 0
    For Each classCode In classes.Keys
        Set wsFrom = FindAssessmentSheetForClass(CStr(classCode), fromAssessment)
        Set wsTo = FindAssessmentSheetForClass(CStr(classCode), toAssessment)
        If Not wsFrom Is Nothing And Not wsTo Is Nothing Then
            BuildFormTeacherProgressForClass CStr(classCode), fromAssessment, toAssessment, False
            builtCount = builtCount + 1
        Else
            skippedCount = skippedCount + 1
        End If
    Next classCode

    BuildFormTeacherProgressNavigation
    MsgBox "Form teacher progress generated for " & builtCount & " class(es): " & fromAssessment & " -> " & toAssessment & _
           IIf(skippedCount > 0, vbCrLf & "Skipped (missing source sheets): " & skippedCount, ""), vbInformation
End Sub

Public Sub BuildFormTeacherProgressForClass(ByVal classCode As String, _
                                            ByVal fromAssessment As String, _
                                            ByVal toAssessment As String, _
                                            Optional ByVal showDoneMessage As Boolean = True)
    Dim wsFrom As Worksheet, wsTo As Worksheet
    Dim idxFrom As Object, idxTo As Object
    Dim subjectMap As Object
    Dim wsOut As Worksheet
    Dim outRow As Long
    Dim studentKey As Variant
    Dim studentRec As Variant
    Dim regNo As String, studentName As String, cls As String
    Dim fromRow As Long, toRow As Long
    Dim yearVal As String

    Set wsFrom = FindAssessmentSheetForClass(classCode, fromAssessment)
    Set wsTo = FindAssessmentSheetForClass(classCode, toAssessment)

    If wsFrom Is Nothing Then
        MsgBox "Could not find source sheet for " & classCode & " / " & fromAssessment, vbExclamation
        Exit Sub
    End If
    If wsTo Is Nothing Then
        MsgBox "Could not find source sheet for " & classCode & " / " & toAssessment, vbExclamation
        Exit Sub
    End If

    Set idxFrom = BuildStudentIndex(wsFrom, classCode)
    Set idxTo = BuildStudentIndex(wsTo, classCode)
    Set subjectMap = BuildSubjectMap(wsFrom, wsTo)

    yearVal = ExtractYearFromSheetName(wsTo.Name)

    Set wsOut = GetOrCreateSheet(BuildReportSheetName("FT_Progress", classCode, fromAssessment, toAssessment))

    PrepareProgressHeader wsOut, classCode, fromAssessment, toAssessment, yearVal

    outRow = 5

    For Each studentKey In idxTo.Keys
        studentRec = idxTo(studentKey) ' Array(regNo, name, class, row)
        regNo = CStr(studentRec(0))
        studentName = CStr(studentRec(1))
        cls = CStr(studentRec(2))
        toRow = CLng(studentRec(3))

        fromRow = 0
        If idxFrom.Exists(studentKey) Then
            fromRow = CLng(idxFrom(studentKey)(3))
        End If

        WriteOneStudentProgress wsFrom, wsTo, subjectMap, fromRow, toRow, _
                                regNo, studentName, cls, _
                                fromAssessment, toAssessment, _
                                wsOut, outRow
        outRow = outRow + 1
    Next studentKey

    FinalizeProgressSheet wsOut, outRow - 1
    BuildFormTeacherProgressNavigation

    If showDoneMessage Then
        MsgBox "Form teacher progress generated for " & classCode & ": " & fromAssessment & " -> " & toAssessment, vbInformation
    End If
End Sub

Private Sub WriteOneStudentProgress(ByVal wsFrom As Worksheet, ByVal wsTo As Worksheet, ByVal subjectMap As Object, _
                                    ByVal fromRow As Long, ByVal toRow As Long, _
                                    ByVal regNo As String, ByVal studentName As String, ByVal cls As String, _
                                    ByVal fromAssessment As String, ByVal toAssessment As String, _
                                    ByVal wsOut As Worksheet, ByVal outRow As Long)

    Dim subj As Variant
    Dim rec As Variant
    Dim fromGrade As String, toGrade As String, fromRaw As String, toRaw As String
    Dim fromPt As Variant, toPt As Variant
    Dim attemptedTo As Long
    Dim improved As Long, declined As Long, unchanged As Long
    Dim sigImp As Long, sigDec As Long
    Dim failFrom As Long, failTo As Long
    Dim abList As String, vrList As String, failListTo As String
    Dim topImproved As String, topDeclined As String
    Dim delta As Double
    Dim sumFrom As Double, sumTo As Double, nFrom As Long, nTo As Long
    Dim avgFrom As Double, avgTo As Double
    Dim rateBand As String, remark As String, talkingPoints As String
    Dim ptDelta As Double

    attemptedTo = 0

    For Each subj In subjectMap.Keys
        rec = subjectMap(subj) ' Array(fromColsCsv, toColsCsv)

        fromGrade = ""
        fromRaw = ""
        toGrade = ""
        toRaw = ""

        If fromRow > 0 Then
            ResolveBestGradeForBaseSubject wsFrom, fromRow, CStr(rec(0)), fromRaw, fromGrade
        End If

        If toRow > 0 Then
            ResolveBestGradeForBaseSubject wsTo, toRow, CStr(rec(1)), toRaw, toGrade
        End If

        ' Track AB / VR explicitly from TO assessment
        If toRaw = "AB" Then
            AppendToken abList, CStr(subj)
            AppendToken failListTo, CStr(subj) & " (AB)"
            failTo = failTo + 1
        ElseIf toRaw = "VR" Then
            AppendToken vrList, CStr(subj)
        End If

        ' Attempted in TO means has valid non-empty normalized grade
        If toGrade <> "" Then attemptedTo = attemptedTo + 1

        fromPt = GradeToComparablePoint(fromGrade)
        toPt = GradeToComparablePoint(toGrade)

        If IsValidComparablePoint(fromPt) Then
            sumFrom = sumFrom + CDbl(fromPt)
            nFrom = nFrom + 1
            If IsFailByComparablePoint(CDbl(fromPt)) Then failFrom = failFrom + 1
        End If

        If IsValidComparablePoint(toPt) Then
            sumTo = sumTo + CDbl(toPt)
            nTo = nTo + 1
            If IsFailByComparablePoint(CDbl(toPt)) Then
                failTo = failTo + 1
                AppendToken failListTo, CStr(subj)
            End If
        End If

        If IsValidComparablePoint(fromPt) And IsValidComparablePoint(toPt) Then
            ptDelta = CDbl(toPt) - CDbl(fromPt) ' lower is better

            If ptDelta < 0 Then
                improved = improved + 1
                If Abs(ptDelta) >= 2# Then sigImp = sigImp + 1
            ElseIf ptDelta > 0 Then
                declined = declined + 1
                If Abs(ptDelta) >= 2# Then sigDec = sigDec + 1
            Else
                unchanged = unchanged + 1
            End If

            UpdateTopMoves CStr(subj), ptDelta, topImproved, topDeclined
        End If
    Next subj

    avgFrom = IIf(nFrom > 0, Round(sumFrom / nFrom, 2), 0#)
    avgTo = IIf(nTo > 0, Round(sumTo / nTo, 2), 0#)
    delta = Round(avgTo - avgFrom, 2)

    rateBand = RateBandFromMetrics(delta, improved, declined, failFrom, failTo)
    remark = BuildAutoRemark(rateBand, failFrom, failTo, sigImp, sigDec)
    talkingPoints = BuildTalkingPoints(topImproved, topDeclined, abList, rateBand)

    wsOut.Cells(outRow, 1).Value = regNo
    wsOut.Cells(outRow, 2).Value = studentName
    wsOut.Cells(outRow, 3).Value = cls
    wsOut.Cells(outRow, 4).Value = attemptedTo
    wsOut.Cells(outRow, 5).Value = avgFrom
    wsOut.Cells(outRow, 6).Value = avgTo
    wsOut.Cells(outRow, 7).Value = delta
    wsOut.Cells(outRow, 8).Value = improved
    wsOut.Cells(outRow, 9).Value = declined
    wsOut.Cells(outRow, 10).Value = unchanged
    wsOut.Cells(outRow, 11).Value = failFrom
    wsOut.Cells(outRow, 12).Value = failTo
    wsOut.Cells(outRow, 13).Value = failTo - failFrom
    wsOut.Cells(outRow, 14).Value = abList
    wsOut.Cells(outRow, 15).Value = vrList
    wsOut.Cells(outRow, 16).Value = failListTo
    wsOut.Cells(outRow, 17).Value = rateBand
    wsOut.Cells(outRow, 18).Value = remark
    wsOut.Cells(outRow, 19).Value = talkingPoints
End Sub

