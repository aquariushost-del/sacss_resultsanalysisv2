Private Function FindAssessmentSheetForClass(ByVal classCode As String, ByVal assessment As String) As Worksheet
    Dim ws As Worksheet
    Dim lvl As String
    Dim aliases As Collection
    lvl = UCase$(Left$(Trim$(classCode), 2))
    Set aliases = GetAssessmentAliases(assessment)

    For Each ws In ThisWorkbook.Worksheets
        If UCase$(ws.Name) Like lvl & "_*" Then
            If SheetNameMatchesAssessment(ws.Name, aliases) Then
                If HasHeader(ws, "Class") And HasHeader(ws, "RegNo") Then
                    Set FindAssessmentSheetForClass = ws
                    Exit Function
                End If
            End If
        End If
    Next ws
End Function

Private Function BuildStudentIndex(ByVal ws As Worksheet, ByVal classCode As String) As Object
    Dim idx As Object
    Dim classCol As Long, regCol As Long, nameCol As Long
    Dim lastRow As Long, r As Long
    Dim cls As String, regNo As String, nm As String, key As String

    Set idx = CreateObject("Scripting.Dictionary")

    classCol = FindHeaderColumn(ws, "Class")
    regCol = FindHeaderColumn(ws, "RegNo")
    nameCol = FindHeaderColumn(ws, "Name")

    If classCol = 0 Or regCol = 0 Then
        Set BuildStudentIndex = idx
        Exit Function
    End If

    lastRow = ws.Cells(ws.Rows.Count, classCol).End(xlUp).Row
    For r = 2 To lastRow
        cls = Trim$(CStr(ws.Cells(r, classCol).Value))
        If UCase$(cls) = UCase$(classCode) Then
            regNo = Trim$(CStr(ws.Cells(r, regCol).Value))
            If nameCol > 0 Then nm = Trim$(CStr(ws.Cells(r, nameCol).Value)) Else nm = ""
            key = BuildStudentKey(regNo, nm, cls)
            If key <> "" Then idx(key) = Array(regNo, nm, cls, r)
        End If
    Next r

    Set BuildStudentIndex = idx
End Function

Private Function BuildSubjectMap(ByVal wsFrom As Worksheet, ByVal wsTo As Worksheet) As Object
    Dim m As Object
    Dim mapFrom As Object, mapTo As Object
    Dim subj As Variant
    Dim baseSubj As String
    Dim arr As Variant

    Set m = CreateObject("Scripting.Dictionary")
    Set mapFrom = GetGradeColumnsBySubject(wsFrom)
    Set mapTo = GetGradeColumnsBySubject(wsTo)

    For Each subj In mapTo.Keys
        baseSubj = NormalizeBaseSubjectName(CStr(subj))
        If Not m.Exists(baseSubj) Then
            m.Add baseSubj, Array("", "")
        End If
        arr = m(baseSubj)
        arr(1) = AppendColCsv(arr(1), CLng(mapTo(subj)))
        If mapFrom.Exists(CStr(subj)) Then arr(0) = AppendColCsv(arr(0), CLng(mapFrom(subj)))
        m(baseSubj) = arr
    Next subj

    For Each subj In mapFrom.Keys
        baseSubj = NormalizeBaseSubjectName(CStr(subj))
        If Not m.Exists(baseSubj) Then
            m.Add baseSubj, Array("", "")
        End If
        arr = m(baseSubj)
        arr(0) = AppendColCsv(arr(0), CLng(mapFrom(subj)))
        If mapTo.Exists(CStr(subj)) Then arr(1) = AppendColCsv(arr(1), CLng(mapTo(subj)))
        m(baseSubj) = arr
    Next subj

    Set BuildSubjectMap = m
End Function

Private Function GetGradeColumnsBySubject(ByVal ws As Worksheet) As Object
    Dim m As Object
    Dim lastCol As Long, c As Long
    Dim h As String, subj As String

    Set m = CreateObject("Scripting.Dictionary")
    lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        h = Trim$(CStr(ws.Cells(1, c).Value))
        If IsGradeHeader(h) Then
            subj = NormalizeSubjectNameFromGradeHeader(h)
            If subj <> "" Then
                If Not m.Exists(subj) Then m.Add subj, c
            End If
        End If
    Next c

    Set GetGradeColumnsBySubject = m
End Function

Private Function IsGradeHeader(ByVal headerText As String) As Boolean
    Dim h As String
    h = UCase$(Trim$(headerText))
    If h = "" Then Exit Function
    If Right$(h, 8) = " (GRADE)" Then
        IsGradeHeader = True
    Else
        IsGradeHeader = False
    End If
End Function

Private Function NormalizeSubjectNameFromGradeHeader(ByVal headerText As String) As String
    Dim h As String
    h = Trim$(headerText)
    If UCase$(Right$(h, 8)) = " (GRADE)" Then
        NormalizeSubjectNameFromGradeHeader = Trim$(Left$(h, Len(h) - 8))
    Else
        NormalizeSubjectNameFromGradeHeader = ""
    End If
End Function

Private Function NormalizeGenericGrade(ByVal gradeRaw As String) As String
    Dim g As String
    g = UCase$(Trim$(gradeRaw))

    If g = "" Or g = "-" Or g = "AB" Or g = "VR" Or g = "MC" Then
        NormalizeGenericGrade = ""
        Exit Function
    End If

    If g = "9" Then g = "F9"

    NormalizeGenericGrade = g
End Function

Private Function GradeToComparablePoint(ByVal gradeStr As String) As Variant
    Dim g As String
    g = UCase$(Trim$(gradeStr))
    If g = "" Then
        GradeToComparablePoint = Empty
        Exit Function
    End If

    Select Case g
        ' G3
        Case "A1": GradeToComparablePoint = 1
        Case "A2": GradeToComparablePoint = 2
        Case "B3": GradeToComparablePoint = 3
        Case "B4": GradeToComparablePoint = 4
        Case "C5": GradeToComparablePoint = 5
        Case "C6": GradeToComparablePoint = 6
        Case "D7": GradeToComparablePoint = 7
        Case "E8": GradeToComparablePoint = 8
        Case "F9": GradeToComparablePoint = 9

        ' G2 (1 best -> 6 worst)
        Case "1": GradeToComparablePoint = 1
        Case "2": GradeToComparablePoint = 2
        Case "3": GradeToComparablePoint = 3
        Case "4": GradeToComparablePoint = 4
        Case "5": GradeToComparablePoint = 5
        Case "6": GradeToComparablePoint = 6

        ' G1 (A best -> E worst)
        Case "A": GradeToComparablePoint = 1
        Case "B": GradeToComparablePoint = 2
        Case "C": GradeToComparablePoint = 3
        Case "D": GradeToComparablePoint = 4
        Case "E": GradeToComparablePoint = 5

        Case Else
            GradeToComparablePoint = Empty
    End Select
End Function

Private Function IsValidComparablePoint(ByVal v As Variant) As Boolean
    If Not IsNumeric(v) Then Exit Function
    If IsEmpty(v) Or IsNull(v) Then Exit Function
    If CDbl(v) < 1# Then Exit Function
    IsValidComparablePoint = True
End Function

Private Function IsFailByComparablePoint(ByVal pt As Double) As Boolean
    ' Cross-scheme approximation:
    '   G3 fail bands: D7/E8/F9 => >=7
    '   G2 fail band: 6
    '   G1 fail band: E (5)
    ' This treats high numeric points as weaker outcomes across schemes.
    IsFailByComparablePoint = (pt >= 5#)
End Function

Private Function TrendLabelFromDelta(ByVal delta As Double) As String
    If delta <= -2# Then
        TrendLabelFromDelta = "Significantly Improved"
    ElseIf delta < 0 Then
        TrendLabelFromDelta = "Improved"
    ElseIf delta >= 2# Then
        TrendLabelFromDelta = "Significantly Declined"
    ElseIf delta > 0 Then
        TrendLabelFromDelta = "Declined"
    Else
        TrendLabelFromDelta = "Unchanged"
    End If
End Function

Private Function RateBandFromMetrics(ByVal avgDelta As Double, ByVal improved As Long, ByVal declined As Long, _
                                     ByVal failFrom As Long, ByVal failTo As Long) As String
    If avgDelta <= -0.5 And improved >= declined And failTo <= failFrom Then
        RateBandFromMetrics = "Strong Improvement"
    ElseIf avgDelta <= -0.2 And improved >= declined Then
        RateBandFromMetrics = "Steady Improvement"
    ElseIf avgDelta >= 0.5 And declined > improved And failTo >= failFrom Then
        RateBandFromMetrics = "Strong Decline"
    ElseIf avgDelta >= 0.2 And declined > improved Then
        RateBandFromMetrics = "Needs Support"
    Else
        RateBandFromMetrics = "Stable"
    End If
End Function

Private Function BuildAutoRemark(ByVal rateBand As String, ByVal failFrom As Long, ByVal failTo As Long, _
                                 ByVal sigImp As Long, ByVal sigDec As Long) As String
    Select Case rateBand
        Case "Strong Improvement"
            BuildAutoRemark = "Clear upward trend since previous assessment. Student is improving in consistency and outcomes."
        Case "Steady Improvement"
            BuildAutoRemark = "Positive progress observed. Continue reinforcement to sustain momentum."
        Case "Strong Decline"
            BuildAutoRemark = "Noticeable decline since previous assessment. Prompt intervention is recommended."
        Case "Needs Support"
            BuildAutoRemark = "Performance has weakened in key areas. Targeted support plan is advised."
        Case Else
            BuildAutoRemark = "Overall performance is stable. Focus on converting near-misses into stronger grades."
    End Select

    If failTo < failFrom Then
        BuildAutoRemark = BuildAutoRemark & " Fail count has improved (" & failFrom & " -> " & failTo & ")."
    ElseIf failTo > failFrom Then
        BuildAutoRemark = BuildAutoRemark & " Fail count increased (" & failFrom & " -> " & failTo & ")."
    End If

    If sigImp > 0 Then BuildAutoRemark = BuildAutoRemark & " Significant gains: " & sigImp & " subject(s)."
    If sigDec > 0 Then BuildAutoRemark = BuildAutoRemark & " Significant declines: " & sigDec & " subject(s)."
End Function

Private Function BuildTalkingPoints(ByVal topImproved As String, ByVal topDeclined As String, _
                                    ByVal abSubjects As String, ByVal rateBand As String) As String
    Dim s As String
    s = ""

    If topImproved <> "" Then s = s & "Strength: " & topImproved & ". "
    If topDeclined <> "" Then s = s & "Concern: " & topDeclined & ". "

    If abSubjects <> "" Then
        s = s & "Attendance concern (AB): " & abSubjects & ". "
    End If

    Select Case rateBand
        Case "Strong Improvement", "Steady Improvement"
            s = s & "Action: sustain current study routine and weekly review."
        Case "Strong Decline", "Needs Support"
            s = s & "Action: immediate intervention plan with weekly teacher check-in."
        Case Else
            s = s & "Action: set 1-2 subject goals before next assessment."
    End Select

    BuildTalkingPoints = Trim$(s)
End Function

Private Sub UpdateTopMoves(ByVal subjectName As String, ByVal ptDelta As Double, _
                           ByRef topImproved As String, ByRef topDeclined As String)
    If ptDelta < 0 Then
        AppendToken topImproved, subjectName & " (" & Format$(ptDelta, "0.0") & ")"
    ElseIf ptDelta > 0 Then
        AppendToken topDeclined, subjectName & " (+" & Format$(ptDelta, "0.0") & ")"
    End If
End Sub

Private Sub AppendToken(ByRef textValue As String, ByVal token As String)
    If Trim$(token) = "" Then Exit Sub
    If textValue <> "" Then textValue = textValue & ", "
    textValue = textValue & token
End Sub

Private Function BuildStudentKey(ByVal regNo As String, ByVal studentName As String, ByVal className As String) As String
    If Trim$(regNo) <> "" Then
        BuildStudentKey = "R:" & UCase$(Trim$(regNo))
    ElseIf Trim$(studentName) <> "" Then
        BuildStudentKey = "N:" & UCase$(Trim$(studentName)) & "|" & UCase$(Trim$(className))
    Else
        BuildStudentKey = ""
    End If
End Function

Private Function FindHeaderColumn(ByVal ws As Worksheet, ByVal headerText As String) As Long
    Dim lastCol As Long, c As Long
    Dim v As String

    lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        v = Trim$(CStr(ws.Cells(1, c).Value))
        If StrComp(v, headerText, vbTextCompare) = 0 Then
            FindHeaderColumn = c
            Exit Function
        End If
    Next c
End Function

Private Function HasHeader(ByVal ws As Worksheet, ByVal headerText As String) As Boolean
    HasHeader = (FindHeaderColumn(ws, headerText) > 0)
End Function

Private Function GetOrCreateSheet(ByVal sheetName As String) As Worksheet
    Dim ws As Worksheet

    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0

    If ws Is Nothing Then
        Set ws = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
        ws.Name = sheetName
    Else
        ws.Cells.Clear
    End If

    Set GetOrCreateSheet = ws
End Function

Private Function ExtractYearFromSheetName(ByVal sheetName As String) As String
    Dim parts() As String
    parts = Split(sheetName, "_")
    If UBound(parts) >= 2 Then
        ExtractYearFromSheetName = parts(UBound(parts))
    Else
        ExtractYearFromSheetName = ""
    End If
End Function

Private Function BuildReportSheetName(ByVal prefix As String, _
                                      ByVal classCode As String, _
                                      ByVal fromAssessment As String, _
                                      ByVal toAssessment As String) As String
    Dim safeClass As String, safeFrom As String, safeTo As String
    Dim tag As String, shortPrefix As String
    Dim maxClassLen As Long

    safeClass = SanitizeSheetToken(classCode)
    safeFrom = SanitizeSheetToken(fromAssessment)
    safeTo = SanitizeSheetToken(toAssessment)
    tag = Right$("0000" & CStr(Abs(SimpleTextHash(safeClass))), 4)

    shortPrefix = "FP"

    ' Target format:
    '   FP_<Class>_<From>_<To>_<Hash>
    maxClassLen = 31 - (Len(shortPrefix) + Len(safeFrom) + Len(safeTo) + Len(tag) + 4)
    If maxClassLen < 3 Then maxClassLen = 3
    If Len(safeClass) > maxClassLen Then safeClass = Left$(safeClass, maxClassLen)

    BuildReportSheetName = shortPrefix & "_" & safeClass & "_" & safeFrom & "_" & safeTo & "_" & tag
    If Len(BuildReportSheetName) > 31 Then BuildReportSheetName = Left$(BuildReportSheetName, 31)
End Function

Private Function SanitizeSheetToken(ByVal token As String) As String
    Dim s As String
    Dim badChars As Variant, ch As Variant

    s = Trim$(token)
    badChars = Array(":", "\", "/", "?", "*", "[", "]")
    For Each ch In badChars
        s = Replace$(s, CStr(ch), "-")
    Next ch

    s = Replace$(s, vbCr, " ")
    s = Replace$(s, vbLf, " ")
    s = Application.WorksheetFunction.Trim(s)
    If s = "" Then s = "X"

    SanitizeSheetToken = s
End Function

Private Function SimpleTextHash(ByVal s As String) As Long
    Dim i As Long
    Dim h As Long
    h = 0
    For i = 1 To Len(s)
        h = ((h * 31) + Asc(Mid$(s, i, 1))) Mod 10000
    Next i
    SimpleTextHash = h
End Function

Private Function NormalizeBaseSubjectName(ByVal subjectName As String) As String
    Dim s As String
    s = UCase$(Trim$(subjectName))
    s = Replace$(s, "  ", " ")

    If Right$(s, 4) = " G1" Then s = Left$(s, Len(s) - 3)
    If Right$(s, 4) = " G2" Then s = Left$(s, Len(s) - 3)
    If Right$(s, 4) = " G3" Then s = Left$(s, Len(s) - 3)
    If Right$(s, 5) = "- G1" Then s = Left$(s, Len(s) - 4)
    If Right$(s, 5) = "- G2" Then s = Left$(s, Len(s) - 4)
    If Right$(s, 5) = "- G3" Then s = Left$(s, Len(s) - 4)

    NormalizeBaseSubjectName = Application.WorksheetFunction.Trim(s)
End Function

Private Function AppendColCsv(ByVal csv As String, ByVal colNum As Long) As String
    If colNum <= 0 Then
        AppendColCsv = csv
        Exit Function
    End If
    If Len(csv) = 0 Then
        AppendColCsv = CStr(colNum)
    Else
        AppendColCsv = csv & "," & CStr(colNum)
    End If
End Function

Private Sub ResolveBestGradeForBaseSubject(ByVal ws As Worksheet, ByVal rowNum As Long, ByVal colsCsv As String, _
                                           ByRef bestRaw As String, ByRef bestGrade As String)
    Dim parts() As String
    Dim i As Long, c As Long
    Dim raw As String, norm As String
    Dim bestPriority As Long, p As Long
    Dim header As String

    bestRaw = ""
    bestGrade = ""
    bestPriority = -1

    If Len(Trim$(colsCsv)) = 0 Then Exit Sub
    parts = Split(colsCsv, ",")

    For i = LBound(parts) To UBound(parts)
        c = CLng(Val(parts(i)))
        If c > 0 Then
            raw = UCase$(Trim$(CStr(ws.Cells(rowNum, c).Value)))
            norm = NormalizeGenericGrade(raw)
            header = CStr(ws.Cells(1, c).Value)
            p = TrackPriorityFromHeader(header)

            If norm <> "" Then
                If p > bestPriority Then
                    bestPriority = p
                    bestRaw = raw
                    bestGrade = norm
                End If
            ElseIf bestRaw = "" Then
                If raw = "AB" Or raw = "VR" Or raw = "MC" Then
                    bestRaw = raw
                    bestGrade = ""
                End If
            End If
        End If
    Next i
End Sub

Private Function TrackPriorityFromHeader(ByVal headerText As String) As Long
    Dim h As String
    h = UCase$(headerText)
    If InStr(1, h, "G3", vbTextCompare) > 0 Then
        TrackPriorityFromHeader = 3
    ElseIf InStr(1, h, "G2", vbTextCompare) > 0 Then
        TrackPriorityFromHeader = 2
    ElseIf InStr(1, h, "G1", vbTextCompare) > 0 Then
        TrackPriorityFromHeader = 1
    Else
        TrackPriorityFromHeader = 0
    End If
End Function

Private Function CollectClassesForAssessment(ByVal assessment As String) As Object
    Dim classes As Object
    Dim ws As Worksheet
    Dim classCol As Long, lastRow As Long, r As Long
    Dim cls As String
    Dim aliases As Collection

    Set classes = CreateObject("Scripting.Dictionary")
    Set aliases = GetAssessmentAliases(assessment)

    For Each ws In ThisWorkbook.Worksheets
        If SheetNameMatchesAssessment(ws.Name, aliases) Then
            If HasHeader(ws, "Class") And HasHeader(ws, "RegNo") Then
                classCol = FindHeaderColumn(ws, "Class")
                If classCol > 0 Then
                    lastRow = ws.Cells(ws.Rows.Count, classCol).End(xlUp).Row
                    For r = 2 To lastRow
                        cls = UCase$(Trim$(CStr(ws.Cells(r, classCol).Value)))
                        If cls <> "" Then
                            If Left$(cls, 1) = "S" Then
                                If Not classes.Exists(cls) Then classes.Add cls, cls
                            End If
                        End If
                    Next r
                End If
            End If
        End If
    Next ws

    Set CollectClassesForAssessment = classes
End Function

Public Sub BuildFormTeacherProgressNavigation()
    Dim wsNav As Worksheet, ws As Worksheet
    Dim startCell As Range
    Dim startRow As Long, startCol As Long, rowPtr As Long
    Dim names() As String
    Dim n As Long, i As Long, k As Long
    Dim shp As Shape

    On Error Resume Next
    Set wsNav = ThisWorkbook.Worksheets(FP_NAV_SHEET_NAME)
    On Error GoTo 0
    If wsNav Is Nothing Then Exit Sub

    Set startCell = wsNav.Range(FP_NAV_START_CELL)
    startRow = startCell.Row
    startCol = startCell.Column

    wsNav.Range(wsNav.Cells(startRow, startCol), wsNav.Cells(startRow + 200, startCol + 5)).Clear
    For k = wsNav.Shapes.Count To 1 Step -1
        Set shp = wsNav.Shapes(k)
        If Left$(shp.Name, Len(FP_NAV_BTN_PREFIX)) = FP_NAV_BTN_PREFIX Then shp.Delete
    Next k

    For Each ws In ThisWorkbook.Worksheets
        If Left$(UCase$(ws.Name), 3) = "FP_" Then
            n = n + 1
            ReDim Preserve names(1 To n)
            names(n) = ws.Name
        End If
    Next ws

    wsNav.Cells(startRow, startCol).Value = "Form Teacher Progress"
    wsNav.Cells(startRow, startCol).Font.Bold = True
    wsNav.Cells(startRow, startCol).Font.Size = 12
    rowPtr = startRow + 1

    If n = 0 Then
        wsNav.Cells(rowPtr, startCol).Value = "(No FP tabs found.)"
        wsNav.Cells(rowPtr, startCol).Font.Italic = True
        Exit Sub
    End If

    SortStringArrayLocal names
    For i = LBound(names) To UBound(names)
        CreateFpNavButton wsNav, names(i), rowPtr, startCol
        rowPtr = rowPtr + 2
    Next i
End Sub

Private Sub CreateFpNavButton(ByVal wsNav As Worksheet, ByVal sheetName As String, ByVal rowNum As Long, ByVal firstCol As Long)
    Dim shp As Shape
    Dim leftPos As Double, topPos As Double
    Dim btnWidth As Double, btnHeight As Double

    leftPos = wsNav.Cells(rowNum, firstCol).Left
    topPos = wsNav.Cells(rowNum, firstCol).Top
    btnWidth = wsNav.Columns(firstCol).Resize(, 5).Width
    btnHeight = wsNav.Rows(rowNum).Height * 1.3

    Set shp = wsNav.Shapes.AddShape(SHAPE_ROUNDED_RECTANGLE, leftPos, topPos, btnWidth, btnHeight)
    With shp
        .Name = FP_NAV_BTN_PREFIX & sheetName
        .Fill.ForeColor.RGB = RGB(222, 235, 247)
        .Line.ForeColor.RGB = RGB(79, 129, 189)
        .Line.Weight = 1.2
        With .TextFrame2
            .TextRange.Text = sheetName
            .TextRange.Font.Name = "Calibri"
            .TextRange.Font.Size = 10.5
            .TextRange.Font.Fill.ForeColor.RGB = RGB(31, 73, 125)
            .TextRange.ParagraphFormat.Alignment = msoAlignCenter
            .VerticalAnchor = msoAnchorMiddle
        End With
    End With
    wsNav.Hyperlinks.Add Anchor:=shp, Address:="", SubAddress:="'" & sheetName & "'!A1"
End Sub

Private Sub SortStringArrayLocal(ByRef arr() As String)
    Dim i As Long, j As Long
    Dim temp As String
    For i = LBound(arr) To UBound(arr) - 1
        For j = i + 1 To UBound(arr)
            If arr(j) < arr(i) Then
                temp = arr(i)
                arr(i) = arr(j)
                arr(j) = temp
            End If
        Next j
    Next i
End Sub

