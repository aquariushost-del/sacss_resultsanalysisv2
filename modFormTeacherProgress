    targetText = targetText & lineText
End Sub

Private Sub ApplyBoldPrefixes(ByVal tgt As Range)
    Dim labels As Variant
    Dim s As String
    Dim i As Long, p As Long, l As Long
    Dim startAt As Long

    s = CStr(tgt.Value)
    If Len(s) = 0 Then Exit Sub

    labels = Array( _
        "Strength:", "Concern:", "Progress trend:", "Subject movement:", _
        "Outcome shift:", "Action:", "Attendance concern (AB):", "VR noted:", _
        "Fail count improved", "Fail count increased", "Fail count remained", _
        "Significant gains", "Significant declines", "AB recorded in:", "VR recorded in:" _
    )

    On Error Resume Next
    tgt.Font.Bold = False

    For i = LBound(labels) To UBound(labels)
        startAt = 1
        Do
            p = InStr(startAt, s, CStr(labels(i)), vbTextCompare)
            If p <= 0 Then Exit Do
            l = Len(CStr(labels(i)))
            tgt.Characters(Start:=p, Length:=l).Font.Bold = True
            startAt = p + l
        Loop
    Next i
    On Error GoTo 0
End Sub

Public Sub ReformatFpRemarksBoldPrefixes()
