            .TextRange.Text = labelText
            .TextRange.Font.Name = "Calibri"
            .TextRange.Font.Size = 10.5
            .TextRange.Font.Fill.ForeColor.RGB = fontColor
            .TextRange.ParagraphFormat.Alignment = msoAlignCenter
            .VerticalAnchor = msoAnchorMiddle
        End With
    End With
    wsNav.Hyperlinks.Add Anchor:=shp, Address:="", SubAddress:="'" & sheetName & "'!A1"
End Sub

Private Sub GetFpLevelPalette(ByVal sheetName As String, ByRef fillColor As Long, ByRef lineColor As Long, ByRef fontColor As Long)
    Dim upperName As String
    upperName = UCase$(sheetName)

    If InStr(1, upperName, "_S1-", vbTextCompare) > 0 Then
        fillColor = RGB(255, 242, 204) ' pastel yellow
        lineColor = RGB(191, 144, 0)
        fontColor = RGB(102, 60, 0)
    ElseIf InStr(1, upperName, "_S2-", vbTextCompare) > 0 Then
        fillColor = RGB(226, 239, 218) ' pastel green
        lineColor = RGB(106, 168, 79)
        fontColor = RGB(39, 78, 19)
    ElseIf InStr(1, upperName, "_S3-", vbTextCompare) > 0 Then
        fillColor = RGB(217, 234, 211) ' light mint
        lineColor = RGB(93, 133, 63)
        fontColor = RGB(35, 60, 25)
    ElseIf InStr(1, upperName, "_S4-", vbTextCompare) > 0 Or InStr(1, upperName, "_S5-", vbTextCompare) > 0 Then
        fillColor = RGB(221, 235, 247) ' pastel blue (shared S4/S5)
        lineColor = RGB(79, 129, 189)
        fontColor = RGB(31, 73, 125)
    Else
        fillColor = RGB(242, 242, 242)
        lineColor = RGB(166, 166, 166)
        fontColor = RGB(68, 68, 68)
    End If
End Sub

Private Sub SortStringArrayLocal(ByRef arr() As String)
    Dim i As Long, j As Long
    Dim temp As String
    For i = LBound(arr) To UBound(arr) - 1
        For j = i + 1 To UBound(arr)
            If arr(j) < arr(i) Then
                temp = arr(i)
                arr(i) = arr(j)
                arr(j) = temp
            End If
        Next j
    Next i
End Sub

Private Function BuildFpMenuLabel(ByVal sheetName As String) As String
    Dim parts() As String
    Dim n As Long
    Dim classToken As String, fromToken As String, toToken As String

    parts = Split(sheetName, "_")
    n = UBound(parts)
    If n >= 4 Then
        classToken = parts(1)
        fromToken = parts(2)
        toToken = parts(3)
        BuildFpMenuLabel = Replace$(classToken, "-", "_") & "_" & fromToken & "_" & toToken
    Else
        BuildFpMenuLabel = sheetName
    End If
End Function

Private Sub AddFpHomeButton(ByVal ws As Worksheet)
    Dim shp As Shape
    Dim tgtCell As Range
    Dim leftPos As Double, topPos As Double
    Dim btnWidth As Double, btnHeight As Double

    Set tgtCell = ws.Range("F1")
    leftPos = tgtCell.Left
    topPos = tgtCell.Top
    btnWidth = tgtCell.Width * 1.2
    btnHeight = tgtCell.Height * 1.2

    On Error Resume Next
    ws.Shapes("HomeBtnFP").Delete
    On Error GoTo 0

    Set shp = ws.Shapes.AddShape(SHAPE_ROUNDED_RECTANGLE, leftPos, topPos, btnWidth, btnHeight)
    With shp
        .Name = "HomeBtnFP"
        .Fill.ForeColor.RGB = RGB(217, 234, 211)
        .Line.ForeColor.RGB = RGB(106, 168, 79)
        .Line.Weight = 1.2
        With .TextFrame2
            .TextRange.Text = "Home"
            .TextRange.Font.Name = "Calibri"
            .TextRange.Font.Size = 10.5
            .TextRange.Font.Fill.ForeColor.RGB = RGB(39, 78, 19)
            .TextRange.ParagraphFormat.Alignment = msoAlignCenter
            .VerticalAnchor = msoAnchorMiddle
        End With
    End With

    ws.Hyperlinks.Add Anchor:=shp, Address:="", SubAddress:="'Dashboard'!A1"
End Sub

Private Function GetAssessmentAliases(ByVal assessment As String) As Collection
    Dim c As New Collection
    Dim a As String

    a = UCase$(Trim$(assessment))

    On Error Resume Next
    c.Add a, a
    Select Case a
        Case "WA1", "TERM1WA"
            c.Add "TERM1WA", "TERM1WA"
            c.Add "TERM1NWA", "TERM1NWA"
            c.Add "WA1", "WA1"
        Case "WA2", "TERM2WA", "TERM2NWA"
            c.Add "TERM2WA", "TERM2WA"
            c.Add "TERM2NWA", "TERM2NWA"
            c.Add "WA2", "WA2"
        Case "WA3", "TERM3WA", "TERM3NWA"
            c.Add "TERM3WA", "TERM3WA"
            c.Add "TERM3NWA", "TERM3NWA"
            c.Add "WA3", "WA3"
        Case "EYE"
            c.Add "EYE", "EYE"
    End Select
    On Error GoTo 0

    Set GetAssessmentAliases = c
End Function

Private Function SheetNameMatchesAssessment(ByVal sheetName As String, ByVal aliases As Collection) As Boolean
    Dim upName As String
    Dim v As Variant

    upName = "_" & UCase$(sheetName) & "_"
    For Each v In aliases
        If InStr(1, upName, "_" & CStr(v) & "_", vbTextCompare) > 0 Then
            SheetNameMatchesAssessment = True
            Exit Function
        End If
    Next v
End Function
