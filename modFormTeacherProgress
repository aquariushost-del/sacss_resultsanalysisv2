Private Function BuildSubjectSpecificAction(ByVal declinedSubjects As String, ByVal failedSubjects As String) As String
    Dim allText As String
    Dim parts() As String
    Dim i As Long
    Dim token As String
    Dim tips As String
    Dim hasEnglish As Boolean, hasMT As Boolean, hasMath As Boolean
    Dim hasScience As Boolean, hasHum As Boolean, hasAes As Boolean, hasApplied As Boolean

    allText = UCase$(declinedSubjects & ", " & failedSubjects)
    tips = ""
    parts = Split(allText, ",")
    For i = LBound(parts) To UBound(parts)
        token = NormalizeSubjectToken(parts(i))
        If token <> "" Then
            Select Case SubjectFamilyFromToken(token)
                Case "ENGLISH": hasEnglish = True
                Case "MOTHER_TONGUE": hasMT = True
                Case "MATHEMATICS": hasMath = True
                Case "SCIENCE": hasScience = True
                Case "HUMANITIES": hasHum = True
                Case "AESTHETICS": hasAes = True
                Case "APPLIED_SUBJECTS": hasApplied = True
            End Select
        End If
    Next i

    If hasEnglish Then AppendToken tips, "English: weekly comprehension + editing drills, and oral reading practice"
    If hasMT Then AppendToken tips, "Mother Tongue: vocabulary consolidation and weekly composition/oral feedback cycle"
    If hasMath Then AppendToken tips, "Math: error-log corrections and 3 timed practice sets per week"
    If hasScience Then AppendToken tips, "Science: concept recap + topical application questions with explanation checks"
    If hasHum Then AppendToken tips, "Humanities: structured answering (PEEL/claim-evidence) and source-based practice"
    If hasAes Then AppendToken tips, "Aesthetics: portfolio/performance checkpoints with rubric-based improvement targets"
    If hasApplied Then AppendToken tips, "Applied subjects: concept-to-practice tasks and weekly mastery checks"

    If tips = "" Then
        BuildSubjectSpecificAction = ""
    Else
        BuildSubjectSpecificAction = "Subject-specific support: " & tips & "."
    End If
End Function

Private Function NormalizeSubjectToken(ByVal rawToken As String) As String
    Dim s As String
    s = UCase$(Trim$(rawToken))
    If s = "" Then Exit Function
    If InStr(1, s, "(", vbTextCompare) > 0 Then s = Left$(s, InStr(1, s, "(", vbTextCompare) - 1)
    If InStr(1, s, "+", vbTextCompare) > 0 Then s = Left$(s, InStr(1, s, "+", vbTextCompare) - 1)
    s = Replace$(s, "(AB)", "")
    s = Application.WorksheetFunction.Trim(s)
    NormalizeSubjectToken = s
End Function

Private Function SubjectFamilyFromToken(ByVal token As String) As String
    ' Hardcoded SEC mapping provided by user (lower + upper sec), with G-track variants collapsed upstream.
    Select Case token
        Case "EL", "LIT", "LIT (EL)"
            SubjectFamilyFromToken = "ENGLISH"

        Case "CL", "HCL", "ML", "HML", "TL", "HTL"
            SubjectFamilyFromToken = "MOTHER_TONGUE"

        Case "MATHS", "A MATHS"
            SubjectFamilyFromToken = "MATHEMATICS"

        Case "SCI", "SCI (C,B)", "SCI (P,C)", "BIO", "CHEM", "PHY"
            SubjectFamilyFromToken = "SCIENCE"

        Case "HUM", "HUM(GEOG)", "HUM(HIST)", "HUM(LIT E)", "GEOG", "HUM(SS, GEOG)", "HUM (SS, LIT IN EL)"
            SubjectFamilyFromToken = "HUMANITIES"

        Case "ART", "DRAMA", "MUSIC"
            SubjectFamilyFromToken = "AESTHETICS"

        Case "NFS", "POA", "EBS"
            SubjectFamilyFromToken = "APPLIED_SUBJECTS"
    End Select
End Function

