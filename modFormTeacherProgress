    parts = Split(s, ",")
    For i = LBound(parts) To UBound(parts)
        If Trim$(parts(i)) <> "" Then CountListItems = CountListItems + 1
    Next i
End Function

Private Function BuildAutoRemark(ByVal rateBand As String, ByVal avgDelta As Double, _
                                 ByVal improved As Long, ByVal declined As Long, ByVal unchanged As Long, _
                                 ByVal failFrom As Long, ByVal failTo As Long, _
                                 ByVal sigImp As Long, ByVal sigDec As Long, _
                                 ByVal abSubjects As String, ByVal vrSubjects As String) As String
    Dim s As String
    Dim line As String
    Dim totalCompared As Long
    totalCompared = improved + declined + unchanged

    Select Case rateBand
        Case "Strong Improvement"
            s = "Marked improvement from the previous assessment, with better overall quality and consistency."
        Case "Steady Improvement"
            s = "Steady improvement is observed, with positive movement in multiple subjects."
        Case "Strong Decline"
            s = "A clear decline is observed compared with the previous assessment and requires immediate intervention."
        Case "Needs Support"
            s = "Performance trend is weakening in key areas and needs closer monitoring and targeted support."
        Case "Stable - High Risk"
            s = "Results are broadly stable, but baseline performance remains weak and high-risk."
        Case "Stable - Watch"
            s = "Results are stable overall, but there are recurring concerns that require close monitoring."
        Case "Stable - Strong"
            s = "Results are stable at a strong level with no current fail concerns."
        Case "Stable - Mixed"
            s = "Results are stable with mixed strengths and gaps across subjects."
        Case Else
            s = "Overall performance is stable, with mixed movement across subjects."
    End Select

    If totalCompared > 0 Then
        AppendLine s, "Subject movement: " & improved & " improved, " & declined & " declined, " & unchanged & " unchanged."
    End If

    If failTo < failFrom Then
        line = "Fail count improved (" & failFrom & " -> " & failTo & ")."
    ElseIf failTo > failFrom Then
        line = "Fail count increased (" & failFrom & " -> " & failTo & ")."
    Else
        line = "Fail count remained at " & failTo & "."
    End If
    AppendLine s, line

    If sigImp > 0 Then AppendLine s, "Significant gains in " & sigImp & " subject(s)."
    If sigDec > 0 Then AppendLine s, "Significant declines in " & sigDec & " subject(s)."

    If abSubjects <> "" Then AppendLine s, "AB recorded in: " & abSubjects & "."
    If vrSubjects <> "" Then AppendLine s, "VR recorded in: " & vrSubjects & "."

    If avgDelta <= -1 Then
        AppendLine s, "Improvement rate is strong and should be sustained."
    ElseIf avgDelta >= 1 Then
        AppendLine s, "Decline is substantial and needs urgent follow-through."
    End If

    BuildAutoRemark = s
End Function

Private Function BuildAiCoachPrompt(ByVal regNo As String, ByVal studentName As String, ByVal className As String, _
                                    ByVal fromAssessment As String, ByVal toAssessment As String, _
                                    ByVal avgFrom As Double, ByVal avgTo As Double, ByVal avgDelta As Double, _
                                    ByVal improved As Long, ByVal declined As Long, ByVal unchanged As Long, _
                                    ByVal failFrom As Long, ByVal failTo As Long, ByVal rateBand As String, _
                                    ByVal topImproved As String, ByVal topDeclined As String, _
                                    ByVal failedSubjectsTo As String, ByVal abSubjects As String, ByVal vrSubjects As String) As String
    Dim s As String
    Dim trendText As String
    Dim severityText As String

    If avgDelta < 0 Then
        trendText = "overall improved"
    ElseIf avgDelta > 0 Then
        trendText = "overall slipped"
    Else
        trendText = "overall remained steady"
    End If

    If Abs(avgDelta) >= 1 Then
        severityText = "large"
    ElseIf Abs(avgDelta) >= 0.5 Then
        severityText = "moderate"
    ElseIf Abs(avgDelta) > 0 Then
        severityText = "small"
    Else
        severityText = "minimal"
    End If

    s = "You are an academic coach. Analyse this student's results and produce: " & _
        "(1) concise status, (2) 3 actionable insights, (3) targeted advice for student, " & _
        "(4) targeted advice for parents, (5) 2-week action plan with measurable checkpoints." & _
        " Keep tone practical and supportive." & vbLf
    s = s & "Student: " & studentName & " | RegNo: " & regNo & " | Class: " & className & vbLf
    s = s & "Assessment comparison: " & fromAssessment & " -> " & toAssessment & vbLf
    s = s & "Current status band: " & rateBand & vbLf
    s = s & "Overall trend summary: Student " & trendText & " from " & fromAssessment & " to " & toAssessment & _
            " (" & severityText & " change)." & vbLf
    s = s & "Subject movement: improved " & improved & ", declined " & declined & ", unchanged " & unchanged & vbLf
    s = s & "Fail count: " & failFrom & " -> " & failTo & vbLf
    If topImproved <> "" Then s = s & "Strength subjects: " & topImproved & vbLf
    If topDeclined <> "" Then s = s & "Concern subjects: " & topDeclined & vbLf
    If failedSubjectsTo <> "" Then s = s & "Failed subjects in " & toAssessment & ": " & failedSubjectsTo & vbLf
    If abSubjects <> "" Then s = s & "AB subjects: " & abSubjects & vbLf
    If vrSubjects <> "" Then s = s & "VR subjects: " & vrSubjects & vbLf
    s = s & "If data is mixed, explain trade-offs clearly and prioritize 2 highest-impact interventions."
    BuildAiCoachPrompt = s
End Function

Private Function BuildTalkingPoints(ByVal topImproved As String, ByVal topDeclined As String, _
                                    ByVal failedSubjectsTo As String, _
                                    ByVal abSubjects As String, ByVal vrSubjects As String, _
                                    ByVal rateBand As String, ByVal avgDelta As Double, _
                                    ByVal failFrom As Long, ByVal failTo As Long) As String
    Dim s As String
    Dim actionLine As String
    s = ""

    If topImproved <> "" Then AppendLine s, "Strength: " & topImproved & "."
    If topDeclined <> "" Then AppendLine s, "Concern: " & topDeclined & "."

    If abSubjects <> "" Then AppendLine s, "Attendance concern (AB): " & abSubjects & "."
    If vrSubjects <> "" Then AppendLine s, "VR noted: " & vrSubjects & "."

    If failTo > failFrom Then
        AppendLine s, "Outcome shift: fail count increased (" & failFrom & " -> " & failTo & ")."
    ElseIf failTo < failFrom Then
        AppendLine s, "Outcome shift: fail count reduced (" & failFrom & " -> " & failTo & ")."
    End If

    If avgDelta <= -0.5 Then
        AppendLine s, "Progress trend: strong positive momentum."
    ElseIf avgDelta < 0 Then
        AppendLine s, "Progress trend: modest positive movement."
    ElseIf avgDelta >= 0.5 Then
        AppendLine s, "Progress trend: clear decline vs previous assessment."
    ElseIf avgDelta > 0 Then
        AppendLine s, "Progress trend: slight decline; monitor closely."
    End If

    Select Case rateBand
        Case "Strong Improvement", "Steady Improvement"
            actionLine = "Action: sustain study routine, set next-target grades, and continue weekly review."
        Case "Strong Decline", "Needs Support"
            actionLine = "Action: immediate intervention plan, parent follow-up, and weekly teacher check-in."
        Case "Stable - Strong", "Stable - Mixed", "Stable - Watch", "Stable - High Risk", "Stable"
            actionLine = "Action: set 1-2 priority subject goals and track completion weekly."
        Case Else
            actionLine = "Action: set 1-2 priority subject goals and track completion weekly."
    End Select

    If BuildSubjectSpecificAction(topDeclined, failedSubjectsTo) <> "" Then
        actionLine = actionLine & " " & BuildSubjectSpecificAction(topDeclined, failedSubjectsTo)
    End If
    AppendLine s, actionLine

    BuildTalkingPoints = Trim$(s)
End Function

