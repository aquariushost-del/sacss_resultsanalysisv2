Private Sub FinalizeProgressSheet(ByVal ws As Worksheet, ByVal lastRow As Long)
    Dim rng As Range
    Dim r As Long
    Dim band As String
    If lastRow >= 4 Then
        Set rng = ws.Range("A4:T" & lastRow)
        With rng.Borders
            .LineStyle = xlContinuous
            .Color = RGB(0, 0, 0)
            .Weight = xlThin
        End With
    End If

    ws.Columns("A:T").AutoFit
    ws.Columns("A").ColumnWidth = 7      ' RegNo
    ws.Columns("B").ColumnWidth = 24     ' Name
    ws.Columns("C").ColumnWidth = 17     ' Class
    ws.Columns("D").ColumnWidth = 12
    ws.Columns("E:M").ColumnWidth = 10
    ws.Columns("N:P").ColumnWidth = 28
    ws.Columns("Q").ColumnWidth = 18
    ws.Columns("R:S").ColumnWidth = 55
    ws.Columns("R:S").WrapText = True
    ws.Columns("T").ColumnWidth = 65
    ws.Columns("T").WrapText = False
    ws.Columns("E:Q").HorizontalAlignment = xlCenter
    ws.Columns("P").WrapText = True
    ws.Columns("P").HorizontalAlignment = xlLeft
    ws.Range("A4:T4").VerticalAlignment = xlCenter

    ' Freeze header row (row 4) so it remains visible when scrolling.
    On Error Resume Next
    ws.Activate
    If Not ActiveWindow Is Nothing Then
        ActiveWindow.FreezePanes = False
        ws.Range("A5").Select
        ActiveWindow.FreezePanes = True
    End If
    On Error GoTo 0

    ' Shade by Rate of Improvement (column Q)
    For r = 5 To lastRow
        band = UCase$(Trim$(CStr(ws.Cells(r, 17).Value)))
        Select Case band
            Case "STRONG IMPROVEMENT"
                ws.Range(ws.Cells(r, 1), ws.Cells(r, 20)).Interior.Color = RGB(226, 239, 218) ' green
            Case "STEADY IMPROVEMENT"
                ws.Range(ws.Cells(r, 1), ws.Cells(r, 20)).Interior.Color = RGB(235, 241, 222) ' light green
            Case "STABLE - STRONG"
                ws.Range(ws.Cells(r, 1), ws.Cells(r, 20)).Interior.Color = RGB(226, 239, 218) ' green
            Case "STABLE - MIXED", "STABLE"
                ws.Range(ws.Cells(r, 1), ws.Cells(r, 20)).Interior.Color = RGB(242, 242, 242) ' neutral gray
            Case "STABLE - WATCH"
                ws.Range(ws.Cells(r, 1), ws.Cells(r, 20)).Interior.Color = RGB(255, 242, 204) ' amber
            Case "STABLE - HIGH RISK"
                ws.Range(ws.Cells(r, 1), ws.Cells(r, 20)).Interior.Color = RGB(244, 204, 204) ' red
            Case "NEEDS SUPPORT"
                ws.Range(ws.Cells(r, 1), ws.Cells(r, 20)).Interior.Color = RGB(255, 242, 204) ' amber
            Case "STRONG DECLINE"
                ws.Range(ws.Cells(r, 1), ws.Cells(r, 20)).Interior.Color = RGB(244, 204, 204) ' red
        End Select

        ApplyBoldPrefixes ws.Cells(r, 18)
        ApplyBoldPrefixes ws.Cells(r, 19)
    Next r

    AddFpHomeButton ws
End Sub

